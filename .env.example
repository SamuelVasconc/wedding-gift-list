# Authentication
ADMIN_PASSWORD=your_password_here
# Set to true to skip the password screen and go straight to /gifts
SKIP_AUTH=false
SESSION_SECRET=your_session_secret_here_minimum_32_characters

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# WhatsApp Contact Numbers (comma-separated, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBERS=+55 16 9999-9999,+55 16 8888-8888

# Email notifications on gift reservation (comma-separated recipients)
OWNER_EMAILS=maira@example.com,samuel@example.com
SMTP_USER=your-gmail@gmail.com
# Gmail App Password (16 chars, requires 2-step verification enabled)
SMTP_PASSWORD=abcdefghijklmnop
# Optional overrides (defaults: smtp.gmail.com / 465 / SMTP_USER)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM="Lista de Presentes <your-gmail@gmail.com>"
